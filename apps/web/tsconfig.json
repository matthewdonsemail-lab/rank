{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "allowImportingTsExtensions": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@listeningkit/ui": ["./src/ui.tsx"],
      "@rank/connectors": ["../../packages/rank-core/src/connectors/index.ts"]
    }
  },
  "include": [
    "src",
    "../../packages/rank-core/src/connectors/index.ts",
    "../../packages/rank-core/src/connectors/types.ts",
    "../../packages/rank-core/src/connectors/connectors.ts"
  ],
  "references": [{ "path": "./tsconfig.node.json" }]
}
