erDiagram
  WORKSPACE ||--o{ API_KEY : owns
  WORKSPACE ||--o{ RANK_SESSION : executes
  WORKSPACE ||--o{ BENCHMARK_RUN : tracks
  RANK_SESSION ||--|{ CANDIDATE : contains
  RANK_SESSION ||--o{ RECEIPT : records

  ENRICHMENT_RUN ||--o{ COMPETITOR_DISCOVERY_RUN : enables
  COMPETITOR_DISCOVERY_RUN ||--o{ PROSPECT_EVALUATION : produces
  OUTBOUND_THREAD ||--o{ CONTACT_RESOLUTION : validates
  OUTBOUND_DOMAIN ||--o{ OUTBOUND_INBOX : provisions
  OUTBOUND_CAMPAIGN ||--o{ OUTBOUND_THREAD : contains
  OUTBOUND_THREAD ||--o{ OUTBOUND_DELIVERY : reserves

  WORKSPACE {
    string id PK
    string name
    string slug
    string ownerId
    string plan
    number createdAt
  }

  API_KEY {
    string id PK
    string workspaceId FK
    string hashedKey
    string label
    array scopes
    number lastUsedAt
  }

  RANK_SESSION {
    string id PK
    string workspaceId FK
    string query
    string strategy
    string model
    number candidateCount
    number latencyMs
    number createdAt
  }

  CANDIDATE {
    string id PK
    string sessionId FK
    string externalId
    string text
    number initialScore
    number rerankScore
    number confidence
    number finalRank
  }

  RECEIPT {
    string id PK
    string sessionId FK
    string provider
    string model
    number tokensUsed
    number costUsd
    number timestamp
  }

  BENCHMARK_RUN {
    string id PK
    string workspaceId FK
    string dataset
    number ndcg10
    number mrr
    number avgLatencyMs
    number completedAt
  }

  BRAND {
    string id PK
    string owner
    string sourceUrl
    string name
    string tagline
    array offerings
    number fetchedAt
  }

  FIRECRAWL_CRAWL {
    string id PK
    string owner
    string crawlId
    string url
    string status
    number pageCount
    number createdAt
    number updatedAt
  }

  ENRICHMENT_RUN {
    string id PK
    string owner
    string sourceUrl
    string state
    object context
    number createdAt
    number updatedAt
  }

  COMPETITOR_DISCOVERY_RUN {
    string id PK
    string sourceEnrichmentRunId FK
    string owner
    string sourceDomain
    string state
    object context
    number createdAt
    number updatedAt
  }

   PROSPECT_EVALUATION {
     string id PK
     string sourceDiscoveryRunId FK
     string owner
     string url
     string state
     string action
     number confidence
     object context
     number createdAt
     number updatedAt
   }

   CONTACT_RESOLUTION {
     string id PK
     string owner
     string state
     object context
     number createdAt
     number updatedAt
   }

   OUTBOUND_DOMAIN {
     string id PK
     string owner
     string domain
     string status
     array localPartPrefixes
     number dailyLimit
     number sentToday
     number warmupScore
   }

   OUTBOUND_INBOX {
     string id PK
     string owner
     string domain FK
     string localPart
     string address
     string status
     number dailyLimit
     number sentToday
   }

   OUTBOUND_CAMPAIGN {
     string id PK
     string owner
     string name
     string goal
     string status
     number dailySendLimit
   }

   OUTBOUND_THREAD {
     string id PK
     string campaignId FK
     string owner
     string state
     object context
     string agentThreadId
     string agentMailThreadId
     string agentMailInboxId
     array labels
     number nextFollowUpAt
   }

   OUTBOUND_DELIVERY {
     string id PK
     string threadId FK
     string owner
     string idempotencyKey
     string provider
     string status
     string providerMessageId
   }
