# Dependencies
node_modules/
.pnpm-store/
__pycache__/
*.py[cod]
*$py.class
# Python virtualenvs. Root-anchored on purpose: a bare `env/` would also match
# source directories such as packages/rank-core/src/env/, silently dropping
# tracked source from fresh clones while local runs keep passing.
.venv/
venv/
/env/

# Environment & Secrets
.env
.env.local
.env.*.local
# Local Rank session home (stored Clerk token + connection config).
# Root-anchored on purpose, like /env/ above: never a source directory.
/.rank/
*.pem
*.key

# Build & Dist
dist/
build/
out/
.next/
*.tsbuildinfo

# Logs & Debug
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.turbo/

# IDE & OS
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# Local-only test tooling (never commit: personal PC cmdlets, scratch installs)
.local/
rank-local*
# External Documentation (pulled locally via scripts, ignored from git)
docs/typesafe/
docs/convex/*
!docs/convex/components/
!docs/convex/components/**
docs/treg/
docs/nebius/
docs/agentmail/
docs/hono/
docs/fumadocs/
docs/clerk/
docs/telnyx/
docs/xstate/upstream/

